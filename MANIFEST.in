include LICENSE
include README.rst
include CHANGELOG.rst
include CONTRIBUTING.rst
include SUPPORT.md
include CONTRIBUTORS.txt
include requirements.txt
include requirements-dev.txt

recursive-include tests *.py
# The maintainer scripts the documentation tells people to run. CONTRIBUTING
# and docs/ both reference them, and an sdist cannot include the repository
# they would otherwise be read from.
recursive-include tools *.py
# The Swing application the GUI tests drive. Its sources ship so the GUI suite
# can be run from an sdist; the compiled classes do not.
recursive-include tests *.java
recursive-exclude tests/java classes

# User-facing documentation. The maintainer notes that live alongside it
# (issue triage, roadmap, reply drafts) are listed in .gitignore and must never
# reach a distribution, so exclude them explicitly rather than relying on the
# glob alone.
recursive-include docs *.md
# A maintainer procedure, not user documentation: it points at notes that are
# themselves not in the sdist.
exclude docs/VERIFY_M0_AND_SOAK.md
exclude docs/DEPENDENCY_ANALYSIS.md
exclude docs/MCP_ENABLING_PLAN.md
exclude docs/TRIAGE.md
exclude docs/ROADMAP.md
exclude docs/PYJAB_MCP_PLAN.md
exclude docs/ISSUE_REPLIES.md
exclude docs/CONSENT_REQUESTS.md
prune docs/replies

# The local-only material: the working agreement, the agent skills and briefs.
# They are gitignored and they are *not* user documentation; an sdist is built
# from the working tree, so .gitignore alone does not keep them out.
# tools/check_local_only_files.py verifies this from the built archive.
prune .agents
exclude AGENTS.md
exclude AGENTS.local.md

prune build
prune dist
global-exclude *.py[cod] __pycache__ *.egg-info .DS_Store
