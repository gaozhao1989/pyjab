# Byte-compiled / cached
__pycache__/
*.py[cod]
*$py.class

# Build artefacts
build/
dist/
*.egg-info/
.eggs/
wheels/

# Test / tooling caches
.pytest_cache/
.tox/
.coverage
htmlcov/

# Downloaded by the GUI test fixtures (tests/conftest.py). 27 Oracle demo
# applications, fetched on demand; never committed.
tests/jnlps/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Scratch files
temp*

# Local-only agent configuration.
#
# AGENTS.md and .agents/skills/ describe how this checkout is worked on -- the
# project rules, the maintainer procedures, the machine's own setup. They are
# local working configuration rather than part of the package or its public
# documentation, so they are deliberately not published.
#
# Note they still take effect: the harness reads them from the working tree.
/AGENTS.md
/AGENTS.local.md
/CLAUDE.md
/CLAUDE.local.md
/.agents/

# Internal working documents.
#
# These are maintainer notes -- issue triage, the delivery roadmap and the
# per-issue reply drafts -- not part of the published project documentation.
# They live in the working tree so they are to hand while working, but they are
# not versioned. The user-facing documentation that *is* versioned lives in
# docs/ and is mirrored to the GitHub wiki; see docs/README.md.
/docs/TRIAGE.md
/docs/ROADMAP.md
/docs/PYJAB_MCP_PLAN.md
/docs/ISSUE_REPLIES.md
/docs/replies/
